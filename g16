#!/usr/bin/env python3
"""Validate NH2 lesson inputs and replay the matching Gaussian output."""

import os
import re
import stat
import subprocess
import sys
import tempfile
import time
from decimal import Decimal
from pathlib import Path


DATA = Path(__file__).resolve().parent.parent / "data"
BASES = {"def2svp", "def2tzvpp"}
ANALYSIS = {"geom=allcheck", "pop=(full,nbo)", "gfinput", "gfoldprint"}
ROUTES = {
    frozenset(("opt", "pop=full")): "opt",
    frozenset(("freq", "geom=allcheck", "guess=read")): "freq",
    frozenset(("freq", "pop=full", "geom=allcheck", "guess=read")): "freq",
    frozenset(("geom=allcheck", "guess=(read,only)", "pop=full")): "read-bb",
    frozenset(("stable", "geom=allcheck", "guess=read", "pop=full")): "stable",
    frozenset(("stable=opt", "geom=allcheck", "guess=read", "pop=full")): "stable-opt",
    frozenset(ANALYSIS | {"guess=(read,only)"}): "read",
    frozenset(ANALYSIS | {"guess=(read,only,alter,save)"}): "swap",
}
SINGLE_POINT_ROUTES = {
    frozenset(("geom=allcheck", "guess=read")): "spe",
    frozenset(("geom=allcheck", "guess=read", "pop=full")): "spe",
    frozenset(("geom=allcheck", "guess=(read,alter)", "pop=full")): "alter",
    frozenset(ANALYSIS | {"guess=read"}): "scf",
}
PREREQUISITES = {
    "freq": ("opt",),
    "spe": ("freq",),
    "read-bb": ("spe",),
    "alter": ("spe", "read-bb"),
    "stable": ("alter",),
    "stable-opt": ("alter", "stable"),
    "read": ("opt",),
    "swap": ("opt",),
    "scf": ("swap",),
}
COURSE_BASES = dict.fromkeys(("spe", "read-bb", "alter", "stable", "stable-opt"), "def2tzvpp")
COURSE_BASES["freq"] = "def2svp"
COURSE_REFERENCES = {
    "spe": "nh2-opt-freq-bb",
    "read-bb": "nh2-opt-freq-bb-read",
    "alter": "nh2-opt-freq-bb-alter",
    "stable": "nh2-opt-freq-bb-stable",
    "stable-opt": "nh2-opt-freq-bb-stable-opt",
}
CHECKPOINT = "NH2 WSL tutorial checkpoint"
CHECKPOINT_NAME = r"[a-zA-Z0-9_-]+(?:\.[a-zA-Z0-9_-]+)*\.[cC][hH][kK]"
LINK0 = {
    "chk": CHECKPOINT_NAME,
    "oldchk": CHECKPOINT_NAME,
    "cpu": r"0-1",
    "nprocshared": r"2",
    "mem": r"1gb|1024mb",
}


def validate(source):
    if "\x00" in source:
        raise ValueError("Use a plain-text Gaussian input.")
    if not source.endswith("\n"):
        raise ValueError("Finish the input with a blank line.")
    lines = [line.strip() for line in source.split("\n")[:-1]]
    headers = {}
    while lines and lines[0].startswith("%"):
        key, _, value = lines.pop(0)[1:].partition("=")
        key, value = key.strip().lower(), value.strip()
        if key not in LINK0 or key in headers or not re.fullmatch(LINK0[key], value, re.IGNORECASE):
            raise ValueError("Check the %chk, %oldchk, CPU and memory lines against the lesson input.")
        headers[key] = value
    if {"cpu", "nprocshared"} <= headers.keys():
        raise ValueError("Use just one of %CPU and %nprocshared.")

    def section(message):
        try:
            end = lines.index("")
        except ValueError:
            raise ValueError(message) from None
        block = lines[:end]
        del lines[:end + 1]
        if not block:
            raise ValueError(message)
        return block

    route = " ".join(section("Start with a route and end it with a blank line.")).lower()
    match = re.fullmatch(r"#(?:[pn]\s+|\s*)(.+)", route)
    words = re.sub(r"\s*,\s*", ",", match[1]).split() if match else []
    geom_check = any(word in {"geom=check", "geom=checkpoint"} for word in words)
    words = [
        "geom=allcheck" if word in {"geom=check", "geom=checkpoint", "geom=allcheckpoint"} else word
        for word in words
    ]
    methods = {f"ub3lyp/{basis}" for basis in BASES} & set(words)
    if len(methods) != 1:
        raise ValueError("The route must specify UB3LYP/def2SVP or UB3LYP/def2TZVPP.")
    keywords = frozenset(set(words) - methods)
    step = ROUTES.get(keywords) or SINGLE_POINT_ROUTES.get(keywords - {"sp"})
    if not step or len(words) != len(set(words)):
        raise ValueError(f"No matching NH2 lesson step for this route: {route}")
    basis = methods.pop().split("/")[1]
    if step in COURSE_BASES and basis != COURSE_BASES[step]:
        raise ValueError(f"Use UB3LYP/{COURSE_BASES[step]} for the {step.upper()} lesson step.")
    chk = headers.get("chk")
    oldchk = headers.get("oldchk")
    if not chk or bool(oldchk) != (step in PREREQUISITES) or (oldchk and chk.casefold() == oldchk.casefold()):
        raise ValueError("Use %chk for this job and, when reading a checkpoint, a separate %oldchk.")

    reference = COURSE_REFERENCES.get(step, f"nh2-{basis}-{step}")
    if step == "opt":
        section("Enter a title followed by a blank line.")
        molecule = section("End the NH2 molecule specification with a blank line.")
        if validate_geometry(molecule, basis):
            reference = "nh2-opt"
    elif step == "freq" and "pop=full" in words:
        reference = "nh2-opt-freq"
    elif step == "spe" and "pop=full" in words:
        reference = "nh2-opt-freq-bb-full"
    if geom_check:
        section("Geom=Check requires a title followed by a blank line.")
        charge = section("Geom=Check requires charge and multiplicity (0 2), then a blank line.")
        if len(charge) != 1 or charge[0].split() != ["0", "2"]:
            raise ValueError("With Geom=Check, enter only 0 2 in the molecule section; coordinates come from %oldchk.")
    if step in {"swap", "alter"}:
        if len(lines) < 3 or lines[0] or lines[1].split() != ["4", "5"] or lines[2]:
            raise ValueError("After the route's blank line, leave another blank line for alpha, then enter 4 5 and a blank line for beta.")
        del lines[:3]
    if any(lines):
        raise ValueError("Remove extra input after the final blank line.")
    if oldchk:
        prior_basis = "def2svp" if step == "spe" else basis
        prior_steps = PREREQUISITES[step]
        path = checkpoint_path(oldchk)
        if not any(matches_checkpoint(path, checkpoint_marker(prior_basis, prior)) for prior in prior_steps):
            allowed = "BB or Read Only" if step == "alter" else " or ".join(prior_steps)
            raise ValueError(f"%oldchk must be the {prior_basis} {allowed} lesson checkpoint.")
    return basis, step, chk, reference


def validate_geometry(molecule, basis):
    if molecule[0].split() != ["0", "2"]:
        raise ValueError("Use charge 0 and multiplicity 2.")
    geometry = [line.lower().split() for line in molecule[1:]]
    if basis == "def2svp" and len(geometry) == 3:
        reference = [line.lower().split() for line in (DATA / "nh2.xyz").read_text().splitlines()[2:]]
        for row, expected in zip(geometry, reference):
            if (
                len(row) != 4
                or row[0] != expected[0]
                or any(not re.fullmatch(r"[+-]?(?:\d+(?:\.\d*)?|\.\d+)", value) for value in row[1:])
                or [Decimal(value) for value in row[1:]] != [Decimal(value) for value in expected[1:]]
            ):
                raise ValueError("Use the three Cartesian coordinate rows from nh2.xyz.")
        return True
    if geometry[:4] != [["n"], ["h", "1", "nh"], ["h", "1", "nh", "2", "hnh"], ["variables:"]]:
        raise ValueError("Use the lesson NH2 Z-matrix with Variables:, nh and hnh.")
    values = {}
    for fields in geometry[4:]:
        if len(fields) != 2 or fields[0] in values or not re.fullmatch(r"\d+(?:\.\d*)?", fields[1]):
            raise ValueError("Set nh to 1.03 and hnh to 120.0.")
        values[fields[0]] = Decimal(fields[1])
    if values != {"nh": Decimal("1.03"), "hnh": Decimal("120.0")}:
        raise ValueError("Set nh to 1.03 and hnh to 120.0.")
    return False


def checkpoint_path(name):
    path = Path(name)
    if path.exists() or path.is_symlink():
        return path
    candidates = [entry for entry in path.parent.iterdir() if entry.name.casefold() == name.casefold()]
    if len(candidates) > 1:
        raise ValueError(f"Checkpoint {name} matches multiple files. Use the exact spelling.")
    return candidates[0] if candidates else path


def matches_checkpoint(path, marker):
    try:
        if path.is_file() and not path.is_symlink():
            with path.open("rb") as handle:
                return handle.read(len(marker) + 1) == marker
    except OSError:
        pass
    return False


def checkpoint_marker(basis, step):
    return f"{CHECKPOINT}\n{basis} {step}\n".encode()


def save_checkpoint(chk, basis, step):
    chk = checkpoint_path(chk)
    marker = checkpoint_marker(basis, step)
    with tempfile.TemporaryDirectory(dir=".") as stage:
        path = Path(stage) / "checkpoint"
        path.write_bytes(marker)
        try:
            os.link(path, chk)
        except FileExistsError:
            if not matches_checkpoint(chk, marker):
                raise ValueError("Choose a different %chk name. This file belongs to another job.")


def open_output():
    """Open the redirected log only when this job owns the terminal."""
    fd = sys.stdout.fileno()
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        return
    try:
        with open("/dev/tty", "r+b", buffering=0) as terminal:
            if os.tcgetpgrp(terminal.fileno()) != os.getpgrp():
                return
            # Bash already opened the output before launching g16.
            path = os.readlink(f"/proc/self/fd/{fd}")
            if not os.path.samestat(os.stat(path), os.fstat(fd)):
                return
            subprocess.run(
                ["vi", "-R", "--", path], stdin=terminal, stdout=terminal, stderr=terminal
            )
    except OSError as error:
        if sys.stderr.isatty():
            print(f"NH₂: 출력은 저장되었습니다. vi로 파일을 여세요. ({error})", file=sys.stderr)


def main():
    try:
        if len(sys.argv) != 1 or sys.stdin.isatty():
            raise ValueError("Usage: g16 < input.inp > output.out")
        source = sys.stdin.buffer.read(65537)
        if len(source) > 65536:
            raise ValueError("The lesson input exceeds 64 KiB.")
        basis, step, chk, reference = validate(source.decode("utf-8").replace("\r\n", "\n"))
        output = (DATA / f"{reference}.out").read_bytes()
        print("NH₂ 모의 계산 중…", file=sys.stderr, flush=True)
        time.sleep(5)
        save_checkpoint(chk, basis, step)
    except (ValueError, OSError) as error:
        print(f"NH2 tutorial: {error}", file=sys.stderr)
        return 1
    sys.stdout.buffer.write(output)
    sys.stdout.buffer.flush()
    print("NH₂ 모의 계산 완료.", file=sys.stderr, flush=True)
    open_output()
    return 0


if __name__ == "__main__":
    sys.exit(main())
