# Loaded by the interactive Bash process for the lesson.
_nh2_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export PATH="$_nh2_dir/bin:$PATH"
unalias g16 2>/dev/null || true
unset -f g16
hash -r

PS1='[\u@lion \W]\$ '
_nh2_workspaces="$HOME/.local/share/dft-nh2/workspaces"
mkdir -p -- "$_nh2_workspaces" || exit 1
printf '%s\n' 'Lion NH₂ 실습 (WSL 모의 환경)'
while IFS= read -r -p '실습 디렉터리 이름 [nh2]: ' _nh2_name; do
    _nh2_name=${_nh2_name:-nh2}
    case $_nh2_name in
        .|..|*/*)
            printf '%s\n' '경로 없이 디렉터리 이름만 입력하세요.' >&2
            continue
            ;;
    esac
    _nh2_workspace="$_nh2_workspaces/$_nh2_name"
    if [[ -L $_nh2_workspace ]]; then
        printf '%s\n' '다른 디렉터리 이름을 사용하세요.' >&2
        continue
    fi
    if mkdir -p -- "$_nh2_workspace" && cd -- "$_nh2_workspace"; then
        unset _nh2_dir _nh2_workspaces _nh2_name _nh2_workspace
        return 0
    fi
done
exit 0
